# Secrets — keep only the template
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tooling caches & reports
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Data: raw HTML cache (~320 MB, re-creatable with `python -m etl.pipeline`)
data/

# Model artifacts (re-creatable with `python -m ml.<model> train`)
models/*
!models/.gitkeep

# ML experiments: tracking runs, checkpoints, scratch outputs (keep code + notebooks, not results)
mlruns/
wandb/
lightning_logs/
*.ckpt
experiments/outputs/
scratch/

# Logs
logs/
*.log

# Editors / OS / local assistant settings
.vscode/
.idea/
.DS_Store
.claude/

# Leftover from the v1 pipeline
.etl_checkpoint.json
